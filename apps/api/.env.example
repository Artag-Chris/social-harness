# ============================================================================
# social-harness API — env de DESARROLLO LOCAL (fuera de docker).
# Copiá este archivo a apps/api/.env. Dentro de docker NO se usa: el compose le
# pasa el entorno del .env de la raíz.
#
# Para levantar la infra local:
#   docker compose -f docker-compose.infra.yml up -d
# ============================================================================

NODE_ENV=development
PORT=3200
CORS_ALLOWED_ORIGINS=*

# ── Postgres/Redis LOCALES (corriendo fuera de docker) ──────────────────────
# OJO: en el server estos hosts son "atiende-postgres" y "redis".
DATABASE_URL=postgresql://socialharness:socialharness@localhost:5435/socialharness?schema=public
# Redis COMPARTIDA, publicada por cv-harness en el puerto host 6380.
# Equivale a `redis:6379` dentro de la red microservices-network.
REDIS_URL=redis://localhost:6380
QUEUE_PREFIX=socialharness

# ── IA (vacías = mock determinístico: el pipeline corre E2E sin red) ─────────
# Misma llave y mismo modelo que atiende/cv-harness.
DEEPSEEK_API_KEY=
# El modelo que usan los otros harnesses en el server es deepseek-v4-flash.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=
LLM_PROVIDER=auto
LLM_FALLBACK=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
EMBEDDING_TIMEOUT_MS=60000

# ── Fuentes ─────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
TRENDS_REGION=CO
RSS_NEWS_EDITION=es-419
RESPECT_ROBOTS=true
SOURCE_DEFAULT_INTERVAL_HOURS=24
FEATURE_CONNECTORS=YOUTUBE_API,GOOGLE_TRENDS,RSS,PUBLIC_WEB,MANUAL

# ── Auth (en el server: el MISMO JWT_SECRET de atiende) ─────────────────────
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d

# ── Scheduler / pipeline / costos ───────────────────────────────────────────
CRON_INTERVAL_MINUTES=360
RELEVANCE_MIN_SCORE=60
IDEAS_PER_WEEK=3
AUTO_IDEAS_ENABLED=true
DEDUP_ENABLED=true
DEDUP_INTERVAL_MINUTES=720
ANALYZE_BATCH_SIZE=20

# ── Notificaciones / observabilidad ─────────────────────────────────────────
NOTIFY_CHANNELS=dashboard
LOG_LEVEL=info
TRUST_PROXY=0

# ── Fixture E2E (dev local con el profile "fixture") ────────────────────────
FIXTURE_ENABLED=true
FIXTURE_BASE_URL=http://localhost:8091
