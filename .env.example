# ============================================================================
# social-harness - Environment variables (raíz; la usa docker compose + el api)
# Copiá este archivo a .env y completá los valores reales. Nunca commitees .env.
#
# Secciones al estilo atiende. El api acepta REDIS_URL directo O lo deriva de
# REDIS_HOST/REDIS_PORT/REDIS_PASSWORD (mismo patrón que atiende → reutiliza la
# misma Redis compartida del server).
# ============================================================================

# ── 1. APLICACIÓN ────────────────────────────────────────────────────────────
NODE_ENV=development
# Puerto del api dentro del contenedor y publicado en el host.
# atiende usa 3013 y cv-harness 3100: acá 3200 para no chocar.
API_PORT=3200
# El frontend NO se levanta acá: es la pestaña "Social Coach" del dashboard de
# atiende (proyecto dashboard/, puerto 3001 del host). No hay WEB_PORT.
# Orígenes permitidos por CORS (CSV). '*' en dev; en el server poné el dominio
# del dashboard. La API usa Bearer (no cookies), así que abrir CORS no expone la
# sesión, pero restringirlo es mejor.
CORS_ALLOWED_ORIGINS=*

# ── 2. POSTGRES / REDIS (EXTERNOS en el server — NO se crean en compose) ─────
# Postgres = el mismo de atiende (atiende-postgres, imagen pgvector) con una
# base "socialharness" propia; se crea SOLA al boot (prisma/ensure-database.ts).
# Para dev local usá:
#   DATABASE_HOST=socialharness-postgres · POSTGRES_USER=socialharness · PASSWORD=socialharness
DATABASE_HOST=atiende-postgres
DATABASE_PORT=5432
POSTGRES_USER=atiende
POSTGRES_PASSWORD=atiende_dev
POSTGRES_DB=socialharness
# OPCIONAL: si preferís pasar la URL completa, esta gana sobre las 4 anteriores.
# DATABASE_URL=postgresql://atiende:atiende_dev@atiende-postgres:5432/socialharness?schema=public
# Redis COMPARTIDA (hostname "redis" en microservices-network), la MISMA que ya
# usan atiende y cv-harness. Si tenés otra, poné la URL completa en REDIS_URL.
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Prefijo de las colas BullMQ para no pisarse con atiende (`atiende:dev:queue`)
# ni con cv-harness (`cvharness`). Comparten la MISMA Redis, así que el prefijo
# es lo único que separa sus llaves.
QUEUE_PREFIX=socialharness

# ── Puertos LOCALES (solo docker-compose.infra.yml / fixture) ────────────────
# Postgres publicado en el host (atiende 5433, cv-harness 5434 → acá 5435).
# La Redis NO se levanta en local: se reutiliza el contenedor compartido `redis`
# y en la red se llega igual por el 6379, así que no hay puerto que reservar.
POSTGRES_PORT=5435
# Fixture E2E publicado en el host (cv-harness usa 8090 → acá 8091).
FIXTURE_PORT=8091
# FIXTURE_ENABLED=false por defecto (server): no existe el fixture E2E ahí.
# En dev local ponelo en true con el profile "fixture" (siembra las fuentes E2E).
FIXTURE_ENABLED=false
FIXTURE_BASE_URL=http://socialharness-fixture

# ── 3. IA (patrón adaptador: un puerto + un adaptador por proveedor) ─────────
# DeepSeek es el proveedor principal: el MISMO que ya usan atiende y cv-harness
# (comparten la llave, así que se copia tal cual de cualquiera de los dos).
#   grep '^DEEPSEEK_API_KEY=' ../cv-harness/.env
DEEPSEEK_API_KEY=
# OJO: el modelo debe ser el MISMO que usan los otros harnesses EN EL SERVER.
# Hoy es deepseek-v4-flash (no el deepseek-chat que traían los .env.example
# viejos). Verificalo antes de desplegar:
#   grep '^DEEPSEEK_MODEL=' ../atiende/.env ../cv-harness/.env
DEEPSEEK_MODEL=deepseek-v4-flash
# Opcional: pasar por un proxy/gateway compatible. Vacío = https://api.deepseek.com
DEEPSEEK_BASE_URL=

# Proveedor principal: auto | deepseek | groq | mock
#   auto = deepseek > groq > mock (sin llaves queda en mock y el pipeline corre
#   E2E igual). Dejalo en `auto` en la plantilla; en tu .env real poné `deepseek`.
LLM_PROVIDER=auto
# Respaldo cuando el principal falla: auto | deepseek | groq | none
#   auto = el otro proveedor que tenga llave. Si ponés uno explícito sin llave,
#   el boot FALLA a propósito (mejor que arrancar sin respaldo sin darte cuenta).
LLM_FALLBACK=auto
# Groq como respaldo (la llave ya existe en el .env de atiende).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=

# Límites de la capa de IA (mismos valores que usa atiende).
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
# Precio del modelo por 1M de tokens, SOLO para el medidor de gasto (GET /usage).
# Vacío = se usa la tabla de apps/api/src/modules/llm/pricing.ts; si el modelo no
# está ahí, el costo queda en 0 y se avisa una vez en el log.
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=

# Embeddings (pgvector, similitud de señales). Igual que atiende: OpenAI
# text-embedding-3-small. Vacía = embeddings mock determinísticos (E2E sin red).
#   grep '^OPENAI_API_KEY=' ../atiende/.env
# OJO: verificado el 2026-09-20, la cuenta de OpenAI responde «You have no
# credits remaining». Sin créditos, `openai` falla siempre y la similitud no es
# real; el vector de cambio es esta variable (y hay que re-embebir lo guardado).
OPENAI_API_KEY=
OPENAI_BASE_URL=
# auto | openai | mock
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
# Tiene que coincidir con la columna vector(1536) del schema (si no, el boot falla).
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100
EMBEDDING_TIMEOUT_MS=60000

# ── 4. FUENTES DE TENDENCIA ──────────────────────────────────────────────────
# YouTube Data API v3 (key gratis con cupo diario). Vacía = el conector
# YOUTUBE_API avisa "sin key" y no corre (las demás fuentes siguen andando).
YOUTUBE_API_KEY=
# Región por defecto de YouTube trends / Google Trends (ISO-3166 alpha-2).
TRENDS_REGION=CO
# Google News en español para las fuentes RSS por keyword.
RSS_NEWS_EDITION=es-419
# Politeness: respetar robots.txt en el conector PUBLIC_WEB (receta CSS).
RESPECT_ROBOTS=true
# Cada cuántas horas corre una fuente nueva si no se le define cadencia propia.
SOURCE_DEFAULT_INTERVAL_HOURS=24
# Conectores HABILITADOS (CSV). Es un feature flag, no una deducción de si hay
# llave: podés tener la key de YouTube y dejar ese conector apagado. Un `kind`
# fuera de esta lista no se despacha aunque tenga fuentes configuradas.
# Válidos: YOUTUBE_API | GOOGLE_TRENDS | RSS | PUBLIC_WEB | MANUAL
# Un valor desconocido hace fallar el boot a propósito (mejor que apagar un
# conector en silencio por un typo).
FEATURE_CONNECTORS=YOUTUBE_API,GOOGLE_TRENDS,RSS,PUBLIC_WEB,MANUAL

# ── 5. AUTH (dashboard) ──────────────────────────────────────────────────────
# MISMO valor que tiene atiende EN EL SERVER: no hay login propio, la pestaña
# reutiliza la sesión de atiende (ver checklist abajo).
# Generar uno nuevo solo si el harness se usara solo: openssl rand -base64 32
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d

# ── 6. SCHEDULER / PIPELINE / COSTOS ─────────────────────────────────────────
# Cada cuántos minutos corre el ciclo que despacha las fuentes vencidas.
CRON_INTERVAL_MINUTES=360
# Relevancia mínima (0-100) de una señal para que el perfil vea una idea.
RELEVANCE_MIN_SCORE=60
# Cuántas ideas nuevas puede pedir un perfil por corrida (freno de costo).
IDEAS_PER_WEEK=3
# Ahorro de costos: false = el pipeline NO genera ideas solo; se piden desde el
# dashboard (POST /profiles/:id/ideas). El análisis de señales sigue igual.
AUTO_IDEAS_ENABLED=true
# Los borradores SIEMPRE son a demanda (botón "Generar borrador"): no hay flag
# para automatizarlos, a propósito.
# Dedup de señales (URL canónica + título/fuente) y su pase periódico.
DEDUP_ENABLED=true
DEDUP_INTERVAL_MINUTES=720
# Máximo de señales nuevas que entran a la llamada de IA por perfil y por ciclo.
ANALYZE_BATCH_SIZE=20

# ── 7. NOTIFICACIONES ────────────────────────────────────────────────────────
# Solo dashboard en v1. Los adaptadores whatsapp/discord son base futura
# (docs/adr-003): se agregan a esta lista cuando existan.
NOTIFY_CHANNELS=dashboard

# ── 8. OBSERVABILIDAD ────────────────────────────────────────────────────────
LOG_LEVEL=info
TRUST_PROXY=0

# ── CHECKLIST SERVER (copiá este archivo a .env en el server) ────────────────
# 1. La base "socialharness" y la extensión pgvector se crean SOLAS al boot
#    (prisma/ensure-database.ts) antes de `migrate deploy` y el seed.
#    No hay que aprovisionar nada a mano.
# 2. JWT_SECRET → el MISMO valor que tiene atiende EN EL SERVER (login sin 2do
#    paso). Obtenelo y copialo tal cual:
#      grep '^JWT_SECRET=' /mnt/storage/LumenX/atiende/.env
#      (o: docker exec <contenedor-atiende> printenv JWT_SECRET)
#    Si no coincide, la pestaña Social del dashboard da 401 «Social Coach
#    rechazó la sesión».
# 3. DEEPSEEK_API_KEY → la MISMA llave que ya usan atiende/cv-harness (o una
#    nueva de platform.deepseek.com). DEEPSEEK_MODEL debe coincidir con el de
#    ellos (hoy deepseek-v4-flash).
# 4. OPENAI_API_KEY   → platform.openai.com (embeddings; vacío = mock)
# 5. YOUTUBE_API_KEY  → console.cloud.google.com (YouTube Data API v3, gratis)
# 6. REDIS_PASSWORD   → si tu Redis compartida la tiene
# 7. FIXTURE_ENABLED=false (queda por defecto) y API_PORT=3200
# 8. Verificá la capa de IA antes de confiar en el pipeline:
#      docker compose exec api npm run llm:check
# Nota: Postgres = "atiende-postgres" y Redis = "redis" en microservices-network.
# ⚠️ NO uses el .env de tu máquina local (apunta a socialharness-postgres).
